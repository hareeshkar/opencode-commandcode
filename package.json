{
  "name": "opencode-commandcode-go",
  "version": "1.1.0",
  "description": "Bridge the $1 Command Code GO plan (no Provider API) into OpenCode. 49 models, real vision, real tool use. For Provider/Pro/Max/GOAT plans you do not need this - connect the API directly.",
  "type": "module",
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./bridge": "./src/bridge.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "opencode-cc-go": "bin/opencode-cc-go.js"
  },
  "files": [
    "!catalog.reachability.json",
    "DEVELOPER.md",
    "LICENSE",
    "README.md",
    "bin",
    "catalog.extracted.json",
    "catalog.json",
    "envelope.generated.json",
    "parts.generated.json",
    "schema.generated.json",
    "scripts",
    "src",
    "test"
  ],
  "scripts": {
    "bridge": "node src/bridge.js",
    "status": "node bin/opencode-cc-go.js status",
    "doctor": "node bin/opencode-cc-go.js doctor",
    "catalog": "node scripts/extract-catalog.mjs > catalog.extracted.json && node scripts/build-catalog.mjs",
    "catalog:probe": "node scripts/extract-catalog.mjs > catalog.extracted.json && node scripts/build-catalog.mjs --probe",
    "schema": "node scripts/extract-envelope.mjs && node scripts/probe-schema.mjs",
    "parts": "node scripts/probe-parts.mjs",
    "discover": "npm run catalog && npm run schema && npm run parts",
    "fixture": "node test/make-fixture-image.mjs",
    "test": "node test/run-all.mjs",
    "install": "node scripts/install.js",
    "uninstall": "node scripts/install.js --remove",
    "service": "zsh scripts/install-service.sh",
    "service:remove": "zsh scripts/install-service.sh --remove",
    "service:status": "zsh scripts/install-service.sh --status"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "commandcode",
    "command-code",
    "go-plan",
    "go",
    "ai",
    "provider",
    "bridge",
    "vision",
    "deepseek",
    "openai-compatible",
    "plugin"
  ],
  "license": "MIT",
  "author": "hareeshkar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hareeshkar/opencode-commandcode.git"
  },
  "bugs": {
    "url": "https://github.com/hareeshkar/opencode-commandcode/issues"
  },
  "homepage": "https://github.com/hareeshkar/opencode-commandcode#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {}
}
